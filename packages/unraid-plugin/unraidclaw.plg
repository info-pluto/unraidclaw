<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "unraidclaw">
<!ENTITY author    "emaspa">
<!ENTITY version   "0.1.31">
<!ENTITY launch    "Settings/unraidclaw">
<!ENTITY github    "info-pluto/unraidclaw">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/packages/unraid-plugin/unraidclaw.plg">
<!ENTITY pkgURL    "https://github.com/&github;/releases/download/v&version;/&name;-&version;-x86_64-1.txz">
<!ENTITY md5       "1d0fb8bec666a9ef7c75f9637096f0f6">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" max="7.99.99" support="https://forums.unraid.net/topic/197498-plugin-support-unraidclaw-ai-agent-gateway-with-permission-control/" icon="microchip" description="Permission-enforcing REST API gateway that lets AI agents manage your Unraid server with fine-grained access control.">

<CHANGES>
### 0.1.31
- Add JDownloader integration with dedicated REST endpoints, permission keys, and OpenClaw tools
- Add Integrations tab in the UnraidClaw WebGUI with dedicated JDownloader settings
- Add configurable integrations.json loading and runtime reload support for external services
</CHANGES>

<README>
**UnraidClaw** is a permission-enforcing REST API gateway that lets AI agents manage your Unraid server.

It proxies requests to Unraid's built-in GraphQL API with fine-grained access control, so you can safely expose Docker, VMs, Array, Shares, System, Notifications, and Network management to AI tools.
</README>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NODE_BIN=""
for p in /usr/local/bin/node /usr/bin/node; do
  if [ -x "$p" ]; then
    NODE_BIN="$p"
    break
  fi
done
if [ -z "$NODE_BIN" ]; then
  NODE_BIN=$(which node 2>/dev/null || true)
fi
if [ -z "$NODE_BIN" ]; then
  echo "ERROR: Node.js is not installed."
  echo "For Unraid 6.x, install Node.js via NerdPack."
  echo "Unraid 7.x should have Node.js built-in."
  exit 1
fi
NODE_VERSION=$($NODE_BIN --version 2>/dev/null | sed 's/v//')
if [ -z "$NODE_VERSION" ]; then
  echo "ERROR: Unable to determine Node.js version."
  exit 1
fi
NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
if [ "$NODE_MAJOR" -lt 22 ]; then
  echo "WARNING: Node.js v${NODE_VERSION} detected. v22+ recommended."
fi
]]>
</INLINE>
</FILE>

<FILE Name="/boot/config/plugins/&name;/&name;-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>&pkgURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
mkdir -p /boot/config/plugins/&name;
if [ ! -f /boot/config/plugins/&name;/permissions.json ]; then
  echo '{}' > /boot/config/plugins/&name;/permissions.json
fi
if [ ! -f /boot/config/plugins/&name;/unraidclaw.cfg ]; then
  cp /usr/local/emhttp/plugins/&name;/default.cfg /boot/config/plugins/&name;/unraidclaw.cfg
fi
chmod +x /etc/rc.d/rc.&name; 2>/dev/null
chmod +x /usr/local/emhttp/plugins/&name;/event/* 2>/dev/null
echo "&name; v&version; installed."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
/etc/rc.d/rc.&name; stop 2>/dev/null
removepkg &name;-&version;-x86_64-1 2>/dev/null
rm -rf /usr/local/emhttp/plugins/&name;
rm -f /etc/rc.d/rc.&name;
echo "&name; removed."
echo "Config files preserved in /boot/config/plugins/&name;/"
]]>
</INLINE>
</FILE>
</PLUGIN>
